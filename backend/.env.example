# ═══════════════════════════════════════════════════════════════
# By Fekas Corp. — Variables de Entorno (.env)
# Copie este archivo como .env y reemplace los valores.
# ═══════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3000

# MongoDB Atlas — La URI debe incluir tls=true en producción
MONGO_URI=mongodb+srv://usuario:clave@cluster.mongodb.net/by_fekas_corp_db?tls=true&retryWrites=true&w=majority

# Seguridad JWT — Mínimo 32 caracteres
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_CHARACTER_SECRET_KEY

# AES-256 — Clave de 32 bytes codificada en Base64 (44 caracteres)
ENCRYPTION_KEY_BASE64=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY_HERE=

# Cloudflare Turnstile
TURNSTILE_SECRET=REPLACE_WITH_TURNSTILE_SECRET
TURNSTILE_HOSTNAME=localhost

# Origen de la aplicación frontend
APP_ORIGIN=http://localhost:5173

# Directorio de uploads privado (fuera del directorio público)
PRIVATE_UPLOAD_DIR=../uploads

# Bootstrap — Solo para la primera ejecución
BOOTSTRAP_EMAIL=admin@byfekas.com
BOOTSTRAP_PASSWORD=CambieMeConAlMenos14Chars!
