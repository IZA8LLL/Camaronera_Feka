{
  "name": "camaronera-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 5173",
    "dev": "ng serve --port 5173",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
